<?xml version="1.0" encoding="utf-8"?>
<!--
  车机大屏设置台。设计约束：
  · 深色背景（#0E1116），夜间行车不刺眼
  · 字号 ≥ 17sp，主要操作文字 20–26sp，数值 34sp
  · 所有可点击控件高度 ≥ 64dp，方便行驶中盲操作
  · 横屏两列布局，充分利用 1920×720 / 1920×1080 车机屏
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="@dimen/page_padding">

        <!-- ================= 左列 ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/card_gap"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- 副标题由 MainActivity 用 BuildConfig.VERSION_NAME 填，界面上一眼能看出装的是哪一版 -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="全屏手势导航"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_hint" />

            <!-- ========== 核心开关 ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开启全屏手势" />

                        <TextView
                            android:id="@+id/tv_switch_hint"
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="关闭时不会创建任何悬浮窗，也不驻留前台服务" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="显示边缘触发区（调试）"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="打开后边缘条会显示淡蓝色，方便确认实际触发范围" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_debug_edge"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="三指空调控制"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body" />

                        <TextView
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="三指左右滑=风量，上下滑=温度；需全屏手势开启" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_ac"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2" />
                </LinearLayout>

            </LinearLayout>

            <!-- ========== 边缘宽度（三边独立） ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="边缘触控区宽度（三边独立）" />

                <!-- 左边缘 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="左边缘（返回）" />

                    <TextView
                        android:id="@+id/tv_edge_left_value"
                        style="@style/ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_edge_left"
                    style="@style/LsSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/seekbar_h"
                    android:max="40"
                    android:progress="10" />

                <!-- 右边缘 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="右边缘（返回）" />

                    <TextView
                        android:id="@+id/tv_edge_right_value"
                        style="@style/ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_edge_right"
                    style="@style/LsSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/seekbar_h"
                    android:max="40"
                    android:progress="10" />

                <!-- 下边缘 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="下边缘（桌面）" />

                    <TextView
                        android:id="@+id/tv_edge_bottom_value"
                        style="@style/ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_edge_bottom"
                    style="@style/LsSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/seekbar_h"
                    android:max="40"
                    android:progress="10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10 dp" />

                    <TextView style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="50 dp" />
                </LinearLayout>

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="三条边缘宽度互不影响。数值越小越不容易误吞应用内贴边操作，越大越好盲操作。" />
            </LinearLayout>

            <!-- ========== 灵敏度 ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="手势灵敏度" />

                    <TextView
                        android:id="@+id/tv_sens_value"
                        style="@style/ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seek_sens"
                    style="@style/LsSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/seekbar_h"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="迟钝 · 要划很远" />

                    <TextView style="@style/CardHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="灵敏 · 轻扫即触发" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_threshold_detail"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="当前阈值：—" />
            </LinearLayout>

            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="全屏导航优化" />

                        <TextView
                            android:id="@+id/tv_projection_hint"
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="打开后可以释放全屏地图左边的空间，请先手动打开小屏导航再打开开关。" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_projection_full"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:minWidth="96dp"
                        android:scaleX="1.4"
                        android:scaleY="1.4"
                        android:thumbTextPadding="16dp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= 右列 ================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ========== 一键授权 ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADB 权限授权" />

                <TextView
                    android:id="@+id/tv_grant_hint"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="检测中…" />

                <Button
                    android:id="@+id/btn_activate"
                    style="@style/LsButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_big"
                    android:layout_marginTop="20dp"
                    android:text="一键启动 / 修复（推荐）" />

                <TextView
                    android:id="@+id/tv_grant_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    android:text="尚未执行操作" />
            </LinearLayout>

            <!-- ========== 仪表卡片（display 1 自绘，合并自仪表助理） ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="仪表卡片" />

                <TextView
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="在仪表屏（display 1）显示车速 / 能耗 / 媒体信息，需要特权通道就绪" />

                <TextView
                    android:id="@+id/tv_card_status"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="卡片：未启动" />

                <Button
                    android:id="@+id/btn_card_start"
                    style="@style/LsButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="14dp"
                    android:text="启动 / 重启卡片" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_card_stop"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="停止卡片" />

                    <Button
                        android:id="@+id/btn_card_media"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="诊断媒体" />
                </LinearLayout>

                <!-- 歌词时间轴校准：听感对不上时按曲目微调一次，下次同一首自动套用 -->
                <TextView
                    android:id="@+id/tv_lyric_offset"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="歌词校准：未在播放" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_lyric_minus500"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="-0.5s" />

                    <Button
                        android:id="@+id/btn_lyric_minus100"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="-0.1s" />

                    <Button
                        android:id="@+id/btn_lyric_plus100"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="+0.1s" />

                    <Button
                        android:id="@+id/btn_lyric_plus500"
                        style="@style/LsButtonGhost"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="+0.5s" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_lyric_reset"
                    style="@style/LsButtonGhost"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="10dp"
                    android:text="清除本曲目偏移" />
            </LinearLayout>

            <!-- ========== 运行状态 ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="运行状态" />

                    <Button
                        android:id="@+id/btn_refresh"
                        style="@style/LsButtonGhost"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:minWidth="120dp"
                        android:text="刷新" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/status_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_gesture_status"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="手势服务：未运行" />

                <TextView
                    android:id="@+id/tv_last_cmd"
                    style="@style/CardHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="最近执行命令：—" />
            </LinearLayout>

            <!-- ========== 日志 + 远程调试（同一张卡） ========== -->
            <LinearLayout style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 日志（默认关闭，排查时再开） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="日志" />

                        <TextView
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="默认关闭。开启后会持续写 logcat 与 files/ls.log，排查完建议关回去以省 CPU" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_log"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2" />
                </LinearLayout>

                <!-- ========== 远程调试（默认关闭，需要时手动开） ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="远程调试" />

                        <TextView
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="默认关闭。开启后车机主动连接远程调试台；排查完建议关回去，减少后台连接" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_remote"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2" />
                </LinearLayout>

                <!-- BYD 诊断日志开关；包不存在时由 MainActivity 整行 GONE -->
                <LinearLayout
                    android:id="@+id/row_byd_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="禁用 BYD 诊断日志" />

                        <TextView
                            style="@style/CardHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="默认关闭。打开后压制 BYD SDK 的 CAN 事件日志 tag（运行时 + persist），logd 写入大幅下降；需要用 4S 诊断导日志时关回即可恢复。" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_byd_log"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginStart="20dp"
                        android:scaleX="1.2"
                        android:scaleY="1.2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
